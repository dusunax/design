{
  "name": "moa",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm --filter @dusunax/moa-storybook build:en",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @dusunax/moa-storybook dev",
    "size": "pnpm --filter @dusunax/moa size",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
