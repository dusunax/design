{
  "name": "@dusunax/moa-render",
  "version": "0.0.0",
  "description": "Render agent UI specs as moa components",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusunax/design.git",
    "directory": "packages/moa-render"
  },
  "files": [
    "dist",
    "README.ko.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@dusunax/moa": "^0.1.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@dusunax/moa": "workspace:*",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
